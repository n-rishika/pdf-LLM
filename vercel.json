{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/static/(.*)", "dest": "/build/static/$1" },
    { "src": "/.*", "dest": "/build/index.html" }
  ],
  "env": {
    "OPENAI_API_KEY": "@openai_api_key"
  }
}